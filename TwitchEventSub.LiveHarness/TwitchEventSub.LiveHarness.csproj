<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TwitchEventSub.LiveHarness</RootNamespace>
    <UserSecretsId>twitch-eventsub-liveharness</UserSecretsId>
    <!-- Local manual test tool only — never packed/shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <!-- Match the library's transitive versions so the combined restore doesn't downgrade (NU1605). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel serves the https://localhost:5000 OAuth redirect using the ASP.NET Core dev cert.
         Trust the dev cert once (see README) so no admin sslcert binding is required. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twitch EventSub library\Twitch.EventSub_Websocket.csproj" />
  </ItemGroup>

</Project>
